{
  "name": "@stevanfreeborn/onspring-ui",
  "version": "0.0.0",
  "description": "Onspring UI locators, fluent Screenplay Tasks, and Questions for Playwright.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(m=>{m.rmSync('dist',{recursive:true,force:true});m.rmSync('tsconfig.tsbuildinfo',{force:true})})\"",
    "build": "tsc -b",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@stevanfreeborn/onspring-models": "^0.0.0",
    "@stevanfreeborn/screenplay": "^0.0.0",
    "@stevanfreeborn/screenplay-playwright": "^0.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "keywords": [
    "onspring",
    "screenplay",
    "playwright",
    "testing"
  ],
  "author": "Stevan Freeborn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevanFreeborn/OnspringEnd2EndTests.git",
    "directory": "packages/onspring-ui"
  },
  "homepage": "https://github.com/StevanFreeborn/OnspringEnd2EndTests/tree/main/packages/onspring-ui#readme",
  "bugs": {
    "url": "https://github.com/StevanFreeborn/OnspringEnd2EndTests/issues"
  }
}
